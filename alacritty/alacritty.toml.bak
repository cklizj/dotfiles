[env]
TERM = "xterm-256color"

[window]
padding.x = 10
padding.y = 10

decorations = "Buttonless"

opacity = 0.8
blur = true 

option_as_alt = "Both"

[font]
size = 13

[font.normal]
family = "FiraCode Nerd Font"
style = "Regular"

[terminal]
shell = { program = "/bin/zsh", args = ["-l"] }

# Import OS-specific config
# (import path is auto-updated by setup.sh)
[general]
import = [
  "~/.config/alacritty/os/mac.toml"
]
